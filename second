<script>
const root=document.documentElement,tgl=document.getElementById('themeToggle');
const saved=localStorage.getItem('surge-theme');
if(saved)root.dataset.theme=saved;else if(matchMedia('(prefers-color-scheme: dark)').matches)root.dataset.theme='dark';
tgl.addEventListener('click',()=>{root.dataset.theme=root.dataset.theme==='dark'?'light':'dark';localStorage.setItem('surge-theme',root.dataset.theme)});
const nav=document.getElementById('nav');addEventListener('scroll',()=>nav.classList.toggle('scrolled',scrollY>12),{passive:true});
const burger=document.getElementById('burger'),mm=document.getElementById('mobileMenu');
burger.addEventListener('click',()=>mm.classList.toggle('open'));
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.08});
document.querySelectorAll('.reveal').forEach(el=>io.observe(el));

// Role chips
const chips=document.getElementById('chips');
function refresh(){
  const picked=[...document.querySelectorAll('input[name=roles]:checked')].map(i=>i.value);
  chips.innerHTML=picked.length?picked.map(r=>`<span class="badge">${r}</span>`).join(''):'<span class="empty">No roles selected yet. Scroll up and tick the roles you want.</span>';
}
document.querySelectorAll('input[name=roles]').forEach(i=>i.addEventListener('change',refresh));

// Submit
// TO CONNECT A REAL INBOX: replace ENDPOINT with your Formspree / Google Apps Script URL.
// Until then, submissions open a pre-filled email to the address below.
const ENDPOINT='';const TO='hello@surgeswim.org';
document.getElementById('applyForm').addEventListener('submit',async e=>{
  e.preventDefault();
  const f=e.target;const roles=[...f.querySelectorAll('input[name=roles]:checked')].map(i=>i.value);
  if(!roles.length){alert('Please select at least one role.');document.getElementById('roles').scrollIntoView({behavior:'smooth'});return;}
  const data={name:f.name.value,email:f.email.value,phone:f.phone.value,grade:f.grade.value,why:f.why.value,roles};
  if(ENDPOINT){try{await fetch(ENDPOINT,{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify(data)});}catch(_){}}
  else{
    const body=`Name: ${data.name}%0AEmail: ${data.email}%0APhone: ${data.phone}%0ASchool/Grade: ${data.grade}%0ARoles: ${roles.join(', ')}%0A%0A${encodeURIComponent(data.why)}`;
    window.open(`mailto:${TO}?subject=${encodeURIComponent('Surge application: '+data.name)}&body=${body}`,'_self');
  }
  document.getElementById('okName').textContent=data.name.split(' ')[0];
  document.getElementById('okEmail').textContent=data.email;
  document.getElementById('formCard').classList.add('sent');
  document.getElementById('formCard').scrollIntoView({behavior:'smooth'});
});
</script>
