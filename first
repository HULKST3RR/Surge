<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Surge | Elite Technical Swimming. Built for Everyone.</title>
<meta name="description" content="Surge is a high-school-led non-profit delivering elite stroke mechanics, video analysis, and race analytics through affordable group lessons.">

<!-- ============ LOGO SLOT 4: FAVICON / BROWSER TAB ============ -->
<link rel="icon" type="image/png" sizes="512x512" href="assets/favicon.png">
<link rel="apple-touch-icon" href="assets/favicon.png">
<meta name="theme-color" content="#0A1128">

<style>
/* ============================================================
   SURGE DESIGN SYSTEM ,  Apple-inspired tokens
   ============================================================ */
:root{
  --obsidian:#0A1128;
  --surge:#0071E3;
  --surge-hover:#0077ED;
  --white:#FFFFFF;
  --slate:#F5F5F7;
  --ink:#1D1D1F;
  --ink-2:#6E6E73;
  --line:rgba(0,0,0,.08);
  --glass:rgba(255,255,255,.72);
  --glass-border:rgba(255,255,255,.55);
  --bg:var(--white);
  --bg-alt:var(--slate);
  --fg:var(--ink);
  --fg-2:var(--ink-2);
  --card:var(--white);
  --shadow:0 20px 60px -20px rgba(10,17,40,.18);
  --radius:22px;
  --ease:cubic-bezier(.22,1,.36,1);
}
[data-theme="dark"]{
  --bg:var(--obsidian);
  --bg-alt:#0F1733;
  --fg:#F5F5F7;
  --fg-2:#A1A1A6;
  --line:rgba(255,255,255,.10);
  --glass:rgba(15,23,51,.62);
  --glass-border:rgba(255,255,255,.12);
  --card:#111A3A;
  --shadow:0 20px 60px -20px rgba(0,0,0,.6);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;-webkit-font-smoothing:antialiased}
body{
  font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text","Inter","Helvetica Neue",Arial,sans-serif;
  background:var(--bg);color:var(--fg);line-height:1.5;
  transition:background .4s var(--ease),color .4s var(--ease);
}
img{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
button{font:inherit;cursor:pointer;border:0;background:none;color:inherit}
.container{width:min(1180px,calc(100% - 48px));margin-inline:auto}
section{padding:120px 0}
@media(max-width:768px){section{padding:80px 0}}

/* Typography */
.eyebrow{font-size:13px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--surge)}
h1{font-size:clamp(40px,6.4vw,76px);font-weight:700;letter-spacing:-.035em;line-height:1.02}
h2{font-size:clamp(32px,4.6vw,56px);font-weight:700;letter-spacing:-.03em;line-height:1.06}
h3{font-size:22px;font-weight:600;letter-spacing:-.015em}
.lead{font-size:clamp(17px,1.6vw,21px);color:var(--fg-2);font-weight:400;max-width:62ch}
.muted{color:var(--fg-2)}
.center{text-align:center}
.stack>*+*{margin-top:16px}
.section-head{max-width:760px;margin:0 auto 64px;text-align:center}
.section-head .lead{margin-inline:auto}

/* Buttons */
.btn{display:inline-flex;align-items:center;gap:8px;padding:14px 26px;border-radius:999px;font-weight:600;font-size:16px;
  transition:transform .35s var(--ease),background .3s,box-shadow .35s var(--ease)}
.btn:hover{transform:translateY(-2px)}
.btn:active{transform:translateY(0) scale(.98)}
.btn-primary{background:var(--surge);color:#fff;box-shadow:0 10px 30px -10px rgba(0,113,227,.6)}
.btn-primary:hover{background:var(--surge-hover);box-shadow:0 16px 40px -10px rgba(0,113,227,.7)}
.btn-ghost{background:transparent;color:var(--surge);border:1.5px solid var(--surge)}
.btn-ghost:hover{background:rgba(0,113,227,.08)}
.btn-sm{padding:10px 18px;font-size:14px}
.link-arrow{color:var(--surge);font-weight:600;display:inline-flex;align-items:center;gap:6px}
.link-arrow svg{transition:transform .3s var(--ease)}
.link-arrow:hover svg{transform:translateX(4px)}

/* Glass */
.glass{background:var(--glass);backdrop-filter:blur(24px) saturate(160%);-webkit-backdrop-filter:blur(24px) saturate(160%);
  border:1px solid var(--glass-border);border-radius:var(--radius);box-shadow:var(--shadow)}

/* Cards */
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:36px;
  transition:transform .5s var(--ease),box-shadow .5s var(--ease),border-color .3s}
.card:hover{transform:translateY(-6px);box-shadow:var(--shadow);border-color:rgba(0,113,227,.25)}
.grid{display:grid;gap:24px}
.grid-2{grid-template-columns:repeat(2,1fr)}
.grid-3{grid-template-columns:repeat(3,1fr)}
@media(max-width:900px){.grid-3{grid-template-columns:1fr}.grid-2{grid-template-columns:1fr}}

/* Icons */
.icon{width:44px;height:44px;border-radius:12px;display:grid;place-items:center;background:rgba(0,113,227,.10);color:var(--surge);margin-bottom:22px}
.icon svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}

/* Badge / divider */
.badge{display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border-radius:999px;font-size:12px;font-weight:600;letter-spacing:.04em;
  background:rgba(0,113,227,.10);color:var(--surge)}
.divider{height:1px;background:linear-gradient(90deg,transparent,var(--line),transparent);margin:0 auto;width:min(1180px,calc(100% - 48px))}

/* Reveal on scroll */
.reveal{opacity:0;transform:translateY(24px);transition:opacity .8s var(--ease),transform .8s var(--ease)}
.reveal.in{opacity:1;transform:none}

/* ============ NAV ============ */
.nav{position:fixed;top:0;left:0;right:0;z-index:100;transition:background .4s,box-shadow .4s,border-color .4s;border-bottom:1px solid transparent}
.nav.scrolled{background:var(--glass);backdrop-filter:blur(24px) saturate(160%);-webkit-backdrop-filter:blur(24px) saturate(160%);border-color:var(--line)}
.nav-inner{display:flex;align-items:center;justify-content:space-between;height:64px}
.nav-logo{display:flex;align-items:center;height:36px}
.nav-logo img{height:36px;width:auto}
.nav-logo .logo-dark{display:none}
[data-theme="dark"] .nav-logo .logo-light{display:none}
[data-theme="dark"] .nav-logo .logo-dark{display:block}
.nav-links{display:flex;gap:32px;font-size:14px;font-weight:500}
.nav-links a{opacity:.8;transition:opacity .2s}
.nav-links a:hover{opacity:1;color:var(--surge)}
.nav-right{display:flex;align-items:center;gap:14px}
.theme-toggle{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;border:1px solid var(--line);transition:background .3s}
.theme-toggle:hover{background:rgba(0,113,227,.08)}
.theme-toggle svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round}
.theme-toggle .moon{display:none}
[data-theme="dark"] .theme-toggle .sun{display:none}
[data-theme="dark"] .theme-toggle .moon{display:block}
.burger{display:none;width:38px;height:38px;place-items:center}
.burger svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round}
@media(max-width:900px){.nav-links,.nav-cta{display:none}.burger{display:grid}}
.mobile-menu{display:none;position:fixed;inset:64px 0 0;background:var(--bg);z-index:99;padding:32px 24px;flex-direction:column;gap:22px;font-size:22px;font-weight:600}
.mobile-menu.open{display:flex}

/* ============ HERO ============ */
.hero{position:relative;min-height:100vh;display:grid;align-items:center;padding:140px 0 100px;overflow:hidden}
.hero-bg{position:absolute;inset:0;z-index:0}
.hero-bg img{width:100%;height:100%;object-fit:cover;opacity:.9}
[data-theme="dark"] .hero-bg img{opacity:.14}
.hero-bg::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,var(--bg) 0%,transparent 30%,transparent 70%,var(--bg) 100%)}
/* LOGO SLOT 2: hero watermark */
.hero-emblem{position:absolute;right:-6%;top:50%;transform:translateY(-50%);width:min(58vw,720px);opacity:.06;z-index:0;pointer-events:none;filter:grayscale(1)}
[data-theme="dark"] .hero-emblem{opacity:.08;filter:grayscale(1) invert(1)}
.hero-inner{position:relative;z-index:1;display:grid;grid-template-columns:1.1fr .9fr;gap:60px;align-items:center}
@media(max-width:900px){.hero-inner{grid-template-columns:1fr}}
.hero-ctas{display:flex;gap:14px;flex-wrap:wrap;margin-top:36px}
.hero-visual{position:relative}
.hero-panel{padding:40px;display:grid;gap:26px}
.hero-stat b{display:block;font-size:44px;font-weight:700;letter-spacing:-.04em;line-height:1;color:var(--surge)}
.hero-stat span{font-size:14px;color:var(--fg-2);font-weight:500}
.hero-stat+.hero-stat{padding-top:22px;border-top:1px solid var(--line)}
.stat-badge{position:absolute;padding:16px 20px;border-radius:18px;display:flex;flex-direction:column;gap:2px;min-width:150px;
  animation:float 6s ease-in-out infinite}
.stat-badge b{font-size:26px;font-weight:700;letter-spacing:-.02em;line-height:1}
.stat-badge span{font-size:12px;color:var(--fg-2);font-weight:500;letter-spacing:.04em;text-transform:uppercase}
.sb-1{top:-5%;left:-10%}
.sb-2{bottom:-5%;right:-8%;animation-delay:-2s}
@media(max-width:900px){.sb-1{left:0}.sb-2{right:0}}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
.trust-row{display:flex;gap:28px;flex-wrap:wrap;margin-top:40px;font-size:13px;color:var(--fg-2);font-weight:500}
.trust-row span{display:flex;align-items:center;gap:8px}
.trust-row svg{width:16px;height:16px;stroke:var(--surge);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}

/* ============ DATA SECTION ============ */
.data-section{background:var(--bg-alt);position:relative;overflow:hidden}
.data-section::before{content:"";position:absolute;width:800px;height:800px;border-radius:50%;
  background:radial-gradient(closest-side,rgba(0,113,227,.14),transparent);top:-300px;right:-200px}
.data-card .big{font-size:clamp(44px,5vw,64px);font-weight:700;letter-spacing:-.04em;line-height:1;color:var(--surge);margin:12px 0 8px}
.data-card .cite{font-size:12px;color:var(--fg-2);margin-top:22px;padding-top:16px;border-top:1px solid var(--line);line-height:1.5}
.data-card .cite sup{color:var(--surge);font-weight:700}

/* ============ COMPARISON ============ */
.compare{border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;background:var(--card)}
.compare table{width:100%;border-collapse:collapse}
.compare th,.compare td{padding:22px 28px;text-align:left;border-bottom:1px solid var(--line);font-size:15px}
.compare th{font-size:13px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--fg-2)}
.compare th.surge-col{color:var(--surge)}
.compare td.surge-col{background:rgba(0,113,227,.05);font-weight:600}
.compare tr:last-child td{border-bottom:0}
.check,.cross{display:inline-grid;place-items:center;width:24px;height:24px;border-radius:50%;vertical-align:middle;margin-right:10px}
.check{background:rgba(0,113,227,.12)}.check svg{stroke:var(--surge)}
.cross{background:rgba(110,110,115,.12)}.cross svg{stroke:var(--fg-2)}
.check svg,.cross svg{width:13px;height:13px;fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
@media(max-width:768px){.compare th,.compare td{padding:16px 14px;font-size:13px}}

/* ============ PROGRAMS ============ */
.program{display:flex;flex-direction:column;gap:0}
.program .price{display:flex;align-items:baseline;gap:6px;margin-top:auto;padding-top:24px}
.program .price b{font-size:32px;letter-spacing:-.03em}
.program .price s{color:var(--fg-2);font-size:14px}
.program ul{list-style:none;margin:18px 0 0;display:grid;gap:10px;font-size:14px;color:var(--fg-2)}
.program li{display:flex;gap:10px;align-items:flex-start}
.program li svg{width:16px;height:16px;flex:none;stroke:var(--surge);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;margin-top:3px}
.dollar-bar{display:flex;height:14px;border-radius:999px;overflow:hidden;margin:28px 0 20px}
.dollar-bar div{transition:flex .6s var(--ease)}
.dollar-legend{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;font-size:14px}
.dollar-legend b{display:block;font-size:20px;letter-spacing:-.02em}
.dollar-legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:8px;font-style:normal}
@media(max-width:768px){.dollar-legend{grid-template-columns:repeat(2,1fr)}}

/* ============ JOIN ============ */
.join-card{position:relative;overflow:hidden;padding:48px;min-height:420px;display:flex;flex-direction:column;justify-content:flex-end;color:#fff;border-radius:var(--radius)}
.join-card.dark{background:linear-gradient(160deg,#111A3A,#0A1128)}
.join-card.blue{background:linear-gradient(160deg,#0A84FF,#0059B8)}
.join-card > *{position:relative}
.join-card p{color:rgba(255,255,255,.78);max-width:46ch}
.join-card .btn{align-self:flex-start;margin-top:24px;background:#fff;color:var(--obsidian)}

/* ============ LEADERSHIP ============ */
.role{font-size:12px;color:var(--surge);font-weight:600;letter-spacing:.08em;text-transform:uppercase;margin-bottom:8px}
.founder-card{display:grid;grid-template-columns:160px 1fr;gap:40px;align-items:center;padding:48px}
.founder-mark{width:160px;height:160px;border-radius:50%;display:grid;place-items:center;background:rgba(0,113,227,.08);border:1px solid var(--line)}
.founder-mark img{width:96px}
.founder-tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}
@media(max-width:768px){.founder-card{grid-template-columns:1fr;padding:32px}}
.roles .card{display:flex;flex-direction:column;padding:28px}
.roles h3{font-size:19px;margin-bottom:10px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.roles .muted{font-size:14px}
.open-pill{font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;padding:3px 9px;border-radius:999px;background:rgba(0,113,227,.10);color:var(--surge)}
.roles-cta{background:linear-gradient(160deg,rgba(0,113,227,.08),transparent)}

/* ============ FOOTER ============ */
footer{background:var(--obsidian);color:#F5F5F7;padding:96px 0 40px}
footer a:hover{color:#fff}
.foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1.4fr;gap:48px}
@media(max-width:900px){.foot-grid{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.foot-grid{grid-template-columns:1fr}}
.foot-logo img{height:44px;width:auto;margin-bottom:20px}
footer h4{font-size:13px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#A1A1A6;margin-bottom:18px}
footer ul{list-style:none;display:grid;gap:12px;font-size:14px;color:#D2D2D7}
footer .form{display:grid;gap:10px}
footer input,footer textarea{width:100%;padding:12px 14px;border-radius:12px;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.06);color:#fff;font:inherit;font-size:14px}
footer input::placeholder,footer textarea::placeholder{color:#8E8E93}
footer input:focus,footer textarea:focus{outline:0;border-color:var(--surge)}
.bib{margin-top:72px;padding-top:40px;border-top:1px solid rgba(255,255,255,.1)}
.bib ol{padding-left:20px;display:grid;gap:12px;font-size:13px;color:#A1A1A6;line-height:1.6}
.bib a{color:#D2D2D7;text-decoration:underline;text-underline-offset:3px}
.foot-bottom{margin-top:48px;padding-top:24px;border-top:1px solid rgba(255,255,255,.1);display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-size:12px;color:#8E8E93}
</style>
</head>
