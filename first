     1. NAVIGATION
     ============================================================ -->
<header class="nav" id="nav">
  <div class="container nav-inner">
    <!-- ===== LOGO SLOT 1: NAV HEADER (light + dark variants) ===== -->
    <a href="#top" class="nav-logo" aria-label="Surge home">
      <img class="logo-light" src="assets/surge-logo.png" alt="Surge">
