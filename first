     ============================================================ -->
<section class="hero">
  <div class="hero-bg"><img src="assets/hero-bg.png" alt=""></div>
  <!-- ===== LOGO SLOT 2: HERO WATERMARK / EMBLEM ===== -->
  <img class="hero-emblem" src="assets/surge-emblem.png" alt="" aria-hidden="true">

  <div class="container hero-inner">
    <div class="stack reveal">
      <span class="badge">
        <svg width="8" height="8" viewBox="0 0 8 8"><circle cx="4" cy="4" r="4" fill="currentColor"/></svg>
        Student-led · Non-profit · Waxhaw, NC
      </span>
      <h1>Elite Technical Swimming.<br>Built for Everyone.</h1>
      <p class="lead">Breakthrough stroke mechanics and video race analytics at a fraction of private coaching costs.</p>
      <div class="hero-ctas">
        <a href="#programs" class="btn btn-primary">Explore Group Lessons</a>
        <a href="#research" class="btn btn-ghost">View Research &amp; Impact</a>
